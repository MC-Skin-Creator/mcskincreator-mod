  "authors": [
    "clixmods"
  ],
  "contact": {
    "homepage": "https://github.com/MC-Skin-Creator",
    "sources": "https://github.com/MC-Skin-Creator/mcskincreator-mod",
    "issues": "https://github.com/MC-Skin-Creator/mcskincreator-mod/issues"
  },
  "license": "LicenseRef-Proprietary-SourceAvailable",
  "icon": "assets/mcskincreator/icon.png",
  "environment": "client",
